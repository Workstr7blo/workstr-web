{
  "name": "workstr-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Static local-first Nostr workout tracker PWA.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "check": "npm run modules && npm test && npm run build",
    "preview": "vite preview --host 0.0.0.0",
    "modules": "node scripts/check-modules.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:smoke": "vite build --config vite.smoke.config.ts",
    "smoke:browser": "node scripts/browser-smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "idb": "^8.0.3",
    "nostr-tools": "^2.18.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.0.16",
    "ws": "^8.21.1"
  }
}
